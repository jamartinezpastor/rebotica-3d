# Variables de ejecución del servidor, nunca VITE_* ni claves en el repositorio.
# Revisa tratamiento y retención de Google antes de habilitar datos reales.
# La API estándar no garantiza retención cero; consulta INTERPRETACION.md.
INTERPRETACION_IA_HABILITADA=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Carga opcional de protocolos al arrancar con PostgreSQL. Los borradores no habilitan triaje.
# PROTOCOLOS_DIR=C:/ruta/al/repositorio/packages/protocolos/data
