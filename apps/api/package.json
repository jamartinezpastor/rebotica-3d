{
  "name": "@rebotica/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "eval:interpretacion": "tsx --env-file-if-exists=../../.env scripts/evaluar-interpretacion.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "@rebotica/db": "workspace:*",
    "@rebotica/dosis": "workspace:*",
    "@rebotica/protocolos": "workspace:*",
    "@rebotica/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15"
  }
}
